# ── Docker 环境变量 ─────────────────────────────────────────
# 用于 docker compose，host 使用服务名而非 localhost

# ── 环境 ────────────────────────────────────────────────────
ENV=production

# ── 端口（Docker 宿主机映射，多项目时修改此处避免冲突）────────
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_template
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fastapi_template

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── 认证 / JWT ──────────────────────────────────────────────
# ⚠️ 生产环境务必替换为长随机字符串
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 超级用户种子数据 ────────────────────────────────────────
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin123456

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["*"]

# ── 限流 ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Sentry（可选）───────────────────────────────────────────
SENTRY_DSN=

# ── 日志 ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
