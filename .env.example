# ── 环境 ───────────────────────────────────────
ENV=development

# ── 端口（Docker 宿主机映射，多项目时修改此处避免冲突）──
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# ── 数据库 ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_template
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:${POSTGRES_PORT:-5432}/fastapi_template

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_URL=redis://localhost:${REDIS_PORT:-6379}/0

# ── Celery ────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:${REDIS_PORT:-6379}/1
CELERY_RESULT_BACKEND=redis://localhost:${REDIS_PORT:-6379}/2

# ── 认证 / JWT ────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 超级用户种子数据 ────────────────────────────────────
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin123456

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── 限流 ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Sentry（可选）─────────────────────────────────
SENTRY_DSN=

# ── 日志 ───────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
